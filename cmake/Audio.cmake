# Audio libraries and host-only regression fixtures. Paths are repository-relative.

add_library(raven-loop-sound STATIC src/audio/raven_loop_sound.cpp)
target_include_directories(raven-loop-sound PUBLIC src)
target_compile_features(raven-loop-sound PUBLIC cxx_std_17)
add_executable(raven-loop-sound-test tests/audio/raven_loop_sound_test.cpp)
target_link_libraries(raven-loop-sound-test PRIVATE raven-loop-sound)
add_executable(raven-loop-sound-runtime-test tests/audio/raven_loop_sound_runtime_test.cpp src/audio/raven_loop_sound_runtime.cpp)
target_link_libraries(raven-loop-sound-runtime-test PRIVATE raven-loop-sound)
add_library(raven-pc-adpcm STATIC src/audio/raven_pc_adpcm.cpp)
add_library(raven-pc-sound-cache STATIC src/audio/raven_pc_sound_cache.cpp)
target_link_libraries(raven-pc-sound-cache PUBLIC raven-pc-adpcm bcrypt)
target_sources(raven-pc-adpcm PRIVATE src/audio/raven_pc_bank.cpp)
target_include_directories(raven-pc-adpcm PUBLIC src)
target_compile_features(raven-pc-adpcm PUBLIC cxx_std_17)
add_executable(raven-pc-adpcm-driver tests/audio/raven_pc_adpcm_driver.cpp)
target_link_libraries(raven-pc-adpcm-driver PRIVATE raven-pc-adpcm)
add_executable(raven-pc-bank-driver tests/audio/raven_pc_bank_driver.cpp)
target_link_libraries(raven-pc-bank-driver PRIVATE raven-pc-adpcm)
add_executable(raven-pc-sound-cache-test tests/audio/raven_pc_sound_cache_test.cpp)
target_link_libraries(raven-pc-sound-cache-test PRIVATE raven-pc-sound-cache)

add_executable(audio-settings-test tests/audio/audio_settings_test.c)
target_include_directories(audio-settings-test PRIVATE external/xboxrecomp/src/kernel)
