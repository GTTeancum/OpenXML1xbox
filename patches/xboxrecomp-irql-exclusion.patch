@@ -54,7 +67,7 @@
             old, NewIrql);
     }
 
-    publish_irql(NewIrql);
+    transition_irql(NewIrql);
     return old;
 }
 
@@ -70,7 +83,7 @@
             g_current_irql, NewIrql);
     }
 
-    publish_irql(NewIrql);
+    transition_irql(NewIrql);
 }
 
