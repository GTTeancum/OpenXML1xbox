-
-    if((uint32_t)InterlockedCompareExchange(&g_contig_next,(LONG)(result+size),(LONG)previous)==previous) break;
+    for (uint32_t i = 0; i < g_contig_free_count; ++i) {
+        uint32_t start = (g_contig_free[i].start + alignment - 1) & ~(alignment - 1);
+        uint64_t end = (uint64_t)g_contig_free[i].start + g_contig_free[i].size;
+        if ((uint64_t)start + size <= end) {
+            contig_take_free(i, start, size);
+            result = start;
+            break;
+        }
     }
+    if (!result) {
+        uint32_t previous = (uint32_t)g_contig_next;
+        result = (previous + alignment - 1) & ~(alignment - 1);
+
+        /* Leave the top of the window for GPU instance memory. */
+        if ((uint64_t)result + size >
+                (uint64_t)XBOX_CONTIG_BASE + XBOX_CONTIG_SIZE
