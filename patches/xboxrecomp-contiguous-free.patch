     memset((void *)((uintptr_t)result + g_memory_offset), 0, size);
     return result;
 }
 
+/* Return a block MmAllocateContiguousMemory handed out. Returns 0 for an
+ * address this allocator does not own, so the caller can try the heap. */
+int xbox_ContiguousFree(uint32_t va)
+{
+    AcquireSRWLockExclusive(&g_contig_lock);
+    uint32_t i = 0;
+    while (i < g_contig_block_count && g_contig_blocks[i].start != va) ++i;
+    if (i == g_contig_block_count) {
+        ReleaseSRWLockExclusive(&g_contig_lock);
+        return 0;
+    }
+    uint32_t start = g_contig_blocks[i].start, size = g_contig_blocks[i].size;
+    g_contig_blocks[i] = g_contig_blocks[--g_contig_block_count];
+
+    /* Insert in address order, merging with the neighbours it touches. */
+    uint32_t at = 0;
+    while (at < g_contig_free_count && g_contig_free[at].start < start) ++at;
+    int merge_before = at > 0 && g_contig_free[at - 1].start + g_contig_free[at - 1].size == start;
+    int merge_after = at < g_contig_free_count && start + size == g_contig_free[at].start;
+    if (merge_before && merge_after) {
+        g_contig_free[at - 1].size += size + g_contig_free[at].size;
+        memmove(&g_contig_free[at], &g_contig_free[at + 1],
+                (g_contig_free_count - at - 1) * sizeof(g_contig_free[0]));
+        g_contig_free_count--;
+        at--;
+    } else if (merge_before) {
+        g_contig_free[at - 1].size += size;
+        at--;
+    } else if (merge_after) {
+        g_contig_free[at].start = start;
+        g_contig_free[at].size += size;
+    } else if (g_contig_free_count < XBOX_CONTIG_MAX_BLOCKS) {
+        memmove(&g_contig_free[at + 1], &g_contig_free[at],
+                (g_contig_free_count - at) * sizeof(g_contig_free[0]));
+        g_contig_free[at].start = start;
+        g_contig_free[at].size = size;
+        g_contig_free_count++;
+    } else {
+        at = g_contig_free_count;  /* table full: the block stays leaked */
+    }
+    /* The top free range gives its space back to the bump pointer. */
+    if (at < g_contig_free_count && at == g_contig_free_count - 1
+            && g_contig_free[at].start + g_contig_free[at].size == (uint32_t)g_contig_next) {
+        InterlockedExchange(&g_contig_next, (LONG)g_contig_free[at].start);
+        g_contig_free_count--;
+    }
+    if (contig_trace())
+        fprintf(stderr, "  [CONTIG] free %08X (%u bytes): %u live blocks, %u free ranges, next %u\n",
+                start, size, g_contig_block_count, g_contig_free_count,
+                (uint32_t)g_contig_next - XBOX_CONTIG_BASE);
+    ReleaseSRWLockExclusive(&g_contig_lock);
+    return 1;
+}
+
