- * Never freed: contiguous blocks are framebuffers and pushbuffers, which a
- * title allocates once. */
+ *
+ * Blocks are also freed. Framebuffers and pushbuffers are allocated once, but
+ * Xbox D3D puts textures and vertex buffers here too and releases them with
+ * MmFreeContiguousMemory when a level unloads. X-Men Legends reloads its level
+ * on every team change; with a pure bump pointer each reload leaked the last
+ * level's resources until the window ran out and D3D fell back to a draw path
+ * the renderer does not implement. Freed ranges are kept sorted and merged,
+ * reused first-fit, and a range that reaches the bump pointer lowers it. */
 static volatile LONG g_contig_next = (LONG)XBOX_CONTIG_BASE;
+/* Never lowered: callers use it to decide whether a physical address was ever
+ * handed out, which a later free does not change. */
+static volatile LONG g_contig_high = (LONG)XBOX_CONTIG_BASE;
+static SRWLOCK g_contig_lock = SRWLOCK_INIT;
+
+#define XBOX_CONTIG_MAX_BLOCKS 32768u
+typedef struct { uint32_t start, size; } xbox_contig_range;
+static xbox_contig_range g_contig_blocks[XBOX_CONTIG_MAX_BLOCKS];  /* live */
+static uint32_t g_contig_block_count;
+static xbox_contig_range g_contig_free[XBOX_CONTIG_MAX_BLOCKS];    /* sorted */
+static uint32_t g_contig_free_count;
+
+static int contig_trace(void)
+{
+    static int enabled = -1;
+    if (enabled < 0) enabled = getenv("XBOX_CONTIG_TRACE") != NULL;
+    return enabled;
+}
+
+/* Carve [result, result + size) out of free range i, keeping what is left. */
+static void contig_take_free(uint32_t i, uint32_t result, uint32_t size)
+{
+    xbox_contig_range r = g_contig_free[i];
+    uint32_t end = r.start + r.size;
+    int before = result > r.start, after = result + size < end;
+    if (before && after) {
+        if (g_contig_free_count >= XBOX_CONTIG_MAX_BLOCKS) return;  /* keep the head only */
+        memmove(&g_contig_free[i + 2], &g_contig_free[i + 1],
+                (g_contig_free_count - i - 1) * sizeof(g_contig_free[0]));
+        g_contig_free[i].size = result - r.start;
+        g_contig_free[i + 1].start = result + size;
+        g_contig_free[i + 1].size = end - (result + size);
+        g_contig_free_count++;
+    } else if (before) {
+        g_contig_free[i].size = result - r.start;
+    } else if (after) {
+        g_contig_free[i].start = result + size;
+        g_contig_free[i].size = end - (result + size);
+    } else {
+        memmove(&g_contig_free[i], &g_contig_free[i + 1],
+                (g_contig_free_count - i - 1) * sizeof(g_contig_free[0]));
+        g_contig_free_count--;
+    }
+}
 
 uint32_t xbox_ContiguousAlloc(uint32_t size, uint32_t alignment)
 {
-    uint32_t result;
+    uint32_t result = 0;
 
     if (alignment < 4096) alignment = 4096;
