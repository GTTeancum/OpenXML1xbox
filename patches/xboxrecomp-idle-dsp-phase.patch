+void mcpx_apu_monitor_idle(MCPXAPUState *d)
+{
+    /* Device pacing continues while the sound engine is stopped. Its DSP
+     * position and any partially completed monitor block must stay intact. */
+    extern void recomp_apu_dsp_output(const int16_t *samples,unsigned frames);
+    static const int16_t silence[256][2] = {0};
+    qemu_mutex_unlock(&d->lock);
+    recomp_apu_dsp_output(&silence[0][0],256);
+    qemu_mutex_lock(&d->lock);
+}
+#endif
