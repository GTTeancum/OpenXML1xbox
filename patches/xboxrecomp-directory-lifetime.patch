+/* Search state belongs to an open directory, never its reusable host handle
+ * value. Keep EOF until restart/close, and allow any number of open searches. */
+static DIR_CONTEXT *s_dir_contexts;
+static SRWLOCK s_dir_lock = SRWLOCK_INIT;
+
+static void close_directory_context(HANDLE handle)
+{
+    AcquireSRWLockExclusive(&s_dir_lock);
+    DIR_CONTEXT **link=&s_dir_contexts;
+    while(*link) {
+        DIR_CONTEXT *ctx=*link;
+        if(ctx->file_handle==handle) {
+            if(ctx->find_handle && ctx->find_handle!=INVALID_HANDLE_VALUE)FindClose(ctx->find_handle);
+            *link=ctx->next;
+            HeapFree(GetProcessHeap(),0,ctx);
+            break;
+        }
+        link=&ctx->next;
+    }
+    ReleaseSRWLockExclusive(&s_dir_lock);
+}
 
