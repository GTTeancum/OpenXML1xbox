diff --git a/src/kernel/guest_vmem.c b/src/kernel/guest_vmem.c
new file mode 100644
index 0000000..ebcb7ed
--- /dev/null
+++ b/src/kernel/guest_vmem.c
@@ -0,0 +1,93 @@
+#include "guest_vmem.h"
+#include "xbox_memory_layout.h"
+#include <string.h>
+extern ptrdiff_t g_xbox_mem_offset;
+
+#define USER_END 0x7FFE0000u
+#define PAGE 4096u
+#define COMMIT 0x1000u
+#define RESERVE 0x2000u
+#define FREE 0x10000u
+#define INVALID 0xC000000Du
+#define CONFLICT 0xC0000018u
+typedef struct { uint32_t owner, state, protect, initial_protect; } vm_page;
+/* Metadata costs 8 MiB; guest address backing is separately configured. */
+static vm_page pages[USER_END / PAGE];
+
+int guest_vmem_allocate(uint32_t *base, uint32_t *size, uint32_t type,
+                        uint32_t protect, uint32_t *status)
+{
+    if (*base < g_xbox_total_ram) return 0;
+    *status = INVALID;
+    uint64_t end64 = ((uint64_t)*base + *size + PAGE - 1) & ~(uint64_t)(PAGE - 1);
+    uint32_t start = *base & ~((type & RESERVE) ? 0xFFFFu : PAGE - 1);
+    if (!*size || (type != RESERVE && type != COMMIT && type != (RESERVE | COMMIT)) ||
+        start < g_xbox_total_ram || end64 > USER_END || end64 <= start) return 1;
+    if (end64 > g_xbox_map_size) { *status = 0xC0000017u; return 1; }
+    uint32_t end = (uint32_t)end64;
+    uint32_t owner = pages[start / PAGE].owner;
+    for (uint32_t p = start / PAGE; p < end / PAGE; ++p) {
+        if ((type & RESERVE) ? pages[p].state != 0 :
+            (!owner || pages[p].owner != owner)) { *status = CONFLICT; return 1; }
+    }
+    if (type & RESERVE) owner = start;
+    for (uint32_t p = start / PAGE; p < end / PAGE; ++p) {
+        if ((type & COMMIT) && pages[p].state != COMMIT)
+            memset((void *)((uintptr_t)g_xbox_mem_offset + p * PAGE), 0, PAGE);
+        pages[p].owner = owner;
+        if (type & RESERVE) pages[p].initial_protect = protect;
+        pages[p].state = (type & COMMIT) ? COMMIT : RESERVE;
+        pages[p].protect = (type & COMMIT) ? protect : 0;
+    }
+    *base = start; *size = end - start; *status = 0;
+    return 1;
+}
+
+int guest_vmem_query(uint32_t address, uint32_t info[7])
+{
+    if (address < g_xbox_total_ram || address >= USER_END) return 0;
+    uint32_t start = address & ~(PAGE - 1);
+    vm_page first = pages[start / PAGE];
+    uint32_t end = start + PAGE;
+    while (end < USER_END) {
+        vm_page *next = &pages[end / PAGE];
+        if (next->owner != first.owner || next->state != first.state ||
+            next->protect != first.protect) break;
+        end += PAGE;
+    }
+    info[0] = start; info[1] = first.owner;
+    info[2] = first.initial_protect; info[3] = end - start;
+    info[4] = first.state ? first.state : FREE;
+    info[5] = first.protect; info[6] = first.state ? 0x20000 : 0;
+    return 1;
+}
+
+int guest_vmem_free(uint32_t *base, uint32_t *size, uint32_t type,
+                    uint32_t *status)
+{
+    if (*base < g_xbox_total_ram) return 0;
+    *status = INVALID;
+    if (*base >= USER_END) return 1;
+    uint32_t start = *base & ~(PAGE - 1), end;
+    uint32_t owner = pages[start / PAGE].owner;
+    if (!owner) return 1;
+    if (type == 0x8000) {
+        if (*size || *base != owner) return 1;
+        end = start;
+        while (end < USER_END && pages[end / PAGE].owner == owner) end += PAGE;
+    } else if (type == 0x4000) {
+        uint64_t finish = ((uint64_t)*base + *size + PAGE - 1) & ~(uint64_t)(PAGE - 1);
+        if (!*size || finish > USER_END) return 1;
+        end = (uint32_t)finish;
+        for (uint32_t p = start / PAGE; p < end / PAGE; ++p)
+            if (pages[p].owner != owner) return 1;
+    } else return 1;
+    for (uint32_t p = start / PAGE; p < end / PAGE; ++p) {
+        if (pages[p].state == COMMIT)
+            memset((void *)((uintptr_t)g_xbox_mem_offset + p * PAGE), 0, PAGE);
+        if (type == 0x8000) memset(&pages[p], 0, sizeof(pages[p]));
+        else { pages[p].state = RESERVE; pages[p].protect = 0; }
+    }
+    *base = start; *size = end - start; *status = 0;
+    return 1;
+}
diff --git a/src/kernel/guest_vmem.h b/src/kernel/guest_vmem.h
new file mode 100644
index 0000000..4bb479f
--- /dev/null
+++ b/src/kernel/guest_vmem.h
@@ -0,0 +1,10 @@
+#pragma once
+#include <stdint.h>
+
+/* Extended user VA allocations backed by the distinct mapping above RAM.
+ * Return 1 when handled, 0 to use the legacy below-RAM implementation. */
+int guest_vmem_allocate(uint32_t *base, uint32_t *size, uint32_t type,
+                        uint32_t protect, uint32_t *status);
+int guest_vmem_query(uint32_t address, uint32_t info[7]);
+int guest_vmem_free(uint32_t *base, uint32_t *size, uint32_t type,
+                    uint32_t *status);
