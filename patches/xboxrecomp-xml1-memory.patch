 #include "recomp_icall_feedback.h"
 #include <stdio.h>
 /* stdlib.h is load-bearing, not tidiness. Without it C89 implicit declaration
@@ -751,6 +752,18 @@ static void bridge_NtAllocateVirtualMemory(void)
     uint32_t size = size_ptr ? BRIDGE_MEM32(size_ptr) : 0;
     /* Read the base address hint (0 = let kernel choose) */
     uint32_t base_hint = base_ptr ? BRIDGE_MEM32(base_ptr) : 0;
+    uint32_t vm_status;
+    if (base_ptr && size_ptr &&
+        guest_vmem_allocate(&base_hint, &size, alloc_type, protect, &vm_status)) {
+        if (!vm_status) {
+            BRIDGE_MEM32(base_ptr) = base_hint;
+            BRIDGE_MEM32(size_ptr) = size;
+        }
+        fprintf(stderr, "  [VM] allocate base=%08X size=%u type=%X status=%08X\n",
+                base_hint, size, alloc_type, vm_status);
+        g_eax = vm_status;
+        return;
+    }
 
     if (KERNEL_LOG_ON()) {
         fprintf(stderr, "  [KERNEL] NtAllocateVirtualMemory: base=0x%08X size=%u type=0x%X prot=0x%X\n",
@@ -929,11 +942,25 @@ static void bridge_NtQueryVirtualMemory(void)
     uint32_t info_va = STACK_ARG(1);
     uint32_t page_base = base_va & ~0xFFFu;
 
-    if (!info_va) {
+    /* The guest VirtualQuery wrapper scans until failure. Success above the
+     * user VMA range makes its 32-bit cursor wrap and scan forever (XML1's
+     * Alchemy memory statistics). This is a guest boundary, not a host query.
+     * Xbox user space ends at 0x7FFEFFFF; allocation/query VMA bases are capped
+     * one 64-KiB allocation unit below that (see Cxbx AddressRanges.h).
+     */
+    const uint32_t user_vma_end = 0x7FFE0000u;
+    if (!info_va || base_va >= user_vma_end) {
         g_eax = 0xC000000Du;               /* STATUS_INVALID_PARAMETER */
         return;
     }
 
+    uint32_t vm_info[7];
+    if (guest_vmem_query(base_va, vm_info)) {
+        for (unsigned i = 0; i < 7; ++i) BRIDGE_MEM32(info_va + i * 4) = vm_info[i];
+        g_eax = 0;
+        return;
+    }
+
     BRIDGE_MEM32(info_va + 0x00) = page_base;          /* BaseAddress */
     BRIDGE_MEM32(info_va + 0x04) = page_base;          /* AllocationBase */
     BRIDGE_MEM32(info_va + 0x08) = 0x04;               /* PAGE_READWRITE */
@@ -944,7 +971,11 @@ static void bridge_NtQueryVirtualMemory(void)
         BRIDGE_MEM32(info_va + 0x0C) = XBOX_TOTAL_RAM - page_base; /* RegionSize */
         BRIDGE_MEM32(info_va + 0x10) = 0x1000;         /* MEM_COMMIT */
     } else {
-        BRIDGE_MEM32(info_va + 0x0C) = 0x1000;
+        /* Return the remaining contiguous free range rather than millions of
+         * individual pages. Preserve the existing flat committed RAM model. */
+        BRIDGE_MEM32(info_va + 0x0C) = page_base < g_xbox_code_lo
+            ? (g_xbox_code_lo & ~0xFFFu) - page_base
+            : user_vma_end - page_base;
         BRIDGE_MEM32(info_va + 0x10) = 0x10000;        /* MEM_FREE */
         BRIDGE_MEM32(info_va + 0x08) = 0;
         BRIDGE_MEM32(info_va + 0x18) = 0;
@@ -965,6 +996,17 @@ static void bridge_NtFreeVirtualMemory(void)
     uint32_t base_ptr = STACK_ARG(0);
     uint32_t size_ptr = STACK_ARG(1);
     uint32_t free_type = STACK_ARG(2);
+    uint32_t base = base_ptr ? BRIDGE_MEM32(base_ptr) : 0;
+    uint32_t size = size_ptr ? BRIDGE_MEM32(size_ptr) : 0;
+    uint32_t status;
+    if (base_ptr && size_ptr && guest_vmem_free(&base, &size, free_type, &status)) {
+        if (!status) {
+            BRIDGE_MEM32(base_ptr) = base;
+            BRIDGE_MEM32(size_ptr) = size;
+        }
+        g_eax = status;
+        return;
+    }
 
     g_eax = (uint32_t)xbox_NtFreeVirtualMemory(
         XBOX_TO_NATIVE(base_ptr), XBOX_TO_NATIVE(size_ptr), free_type);
diff --git a/src/kernel/xbox_memory_layout.h b/src/kernel/xbox_memory_layout.h
index 90dbd7c..f891cbc 100644
--- a/src/kernel/xbox_memory_layout.h
+++ b/src/kernel/xbox_memory_layout.h
@@ -388,25 +388,9 @@ extern RECOMP_TLS uint32_t g_fs_base;
 /** Base VA of the dynamic heap area (above stack). */
 #define XBOX_HEAP_BASE      (XBOX_STACK_BASE + XBOX_STACK_SIZE)  /* 0x00F80000 */
 
-/** Exclusive top of the dynamic heap: the end of RAM for this run. Runtime,
- *  not a macro, because RAM size is now configurable (retail 64 MB vs devkit
- *  128 MB). The total mapped region (data + stack + heap) equals RAM so the
- *  engine's memory probing stops at the correct boundary. */
-/* The heap runs to the end of the *mapped* range, not the end of RAM.
- *
- * When a title maps more address space than it has RAM, a large
- * MEM_RESERVE has to come from somewhere. Carving it out of a separate
- * arena above the heap looked tidy and was wrong: the guest CRT's own
- * bookkeeping never learns about that region, so realloc's block lookup
- * fails for a pointer in it and the copy is skipped -- a grown buffer
- * comes back empty with the old one still intact. Half-Life 2 loses a
- * 129-node CUtlRBTree that way, and the tree then self-cycles.
- *
- * Letting the ordinary heap serve the whole mapped range keeps every
- * allocation inside one allocator the guest already understands.
- */
-#define XBOX_HEAP_TOP       ((uint32_t)(g_xbox_map_size ? g_xbox_map_size \
-                                                        : g_xbox_total_ram))
+/* XML1 tracks extended reservations separately; the physical heap must not
+ * grow into that arena or two allocators can hand out the same guest pages. */
+#define XBOX_HEAP_TOP       ((uint32_t)g_xbox_total_ram)
 
 /** No static mirror/guard region. RAM mirror is handled via file mapping
  *  views that alias the same physical pages as the base 64 MB region. */
