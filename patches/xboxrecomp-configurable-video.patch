diff --git a/src/kernel/kernel_xbox.c b/src/kernel/kernel_xbox.c
index 88b7c68..36914eb 100644
--- a/src/kernel/kernel_xbox.c
+++ b/src/kernel/kernel_xbox.c
@@ -12,6 +12,22 @@
 #include "kernel.h"
 #include <string.h>
 
+static ULONG configured_video_flags = XC_VIDEO_FLAGS_WIDESCREEN | XC_VIDEO_FLAGS_HDTV;
+void xbox_kernel_set_video_flags(ULONG flags) {
+    configured_video_flags = flags & (XC_VIDEO_FLAGS_WIDESCREEN |
+        XC_VIDEO_FLAGS_HDTV | XC_VIDEO_FLAGS_HDTV_1080i | XC_VIDEO_FLAGS_LETTERBOX);
+}
+ULONG xbox_kernel_get_video_flags(void) { return configured_video_flags; }
+ULONG xbox_kernel_get_video_capabilities(void) {
+    ULONG caps = AV_FLAGS_HDTV_480i | AV_FLAGS_60Hz;
+    if(configured_video_flags & XC_VIDEO_FLAGS_HDTV_480p) caps |= AV_FLAGS_HDTV_480p;
+    if(configured_video_flags & XC_VIDEO_FLAGS_HDTV_720p) caps |= AV_FLAGS_HDTV_720p;
+    if(configured_video_flags & XC_VIDEO_FLAGS_HDTV_1080i) caps |= AV_FLAGS_HDTV_1080i;
+    if(configured_video_flags & XC_VIDEO_FLAGS_WIDESCREEN) caps |= AV_FLAGS_WIDESCREEN;
+    if(configured_video_flags & XC_VIDEO_FLAGS_LETTERBOX) caps |= AV_FLAGS_LETTERBOX;
+    return caps;
+}
+
 /* ============================================================================
  * Exported Data Objects
  *
@@ -148,7 +164,7 @@ NTSTATUS __stdcall xbox_ExQueryNonVolatileSetting(
         /* Dashboard flags use bits16..23. XGetVideoFlags shifts by16;
          * low-byte values silently disable widescreen and HD selection. */
         if (ValueLength >= sizeof(ULONG)) {
-            *(PULONG)Value = XC_VIDEO_FLAGS_WIDESCREEN | XC_VIDEO_FLAGS_HDTV;
+            *(PULONG)Value = xbox_kernel_get_video_flags();
             if (Type) *Type = 4; /* REG_DWORD */
             if (ResultLength) *ResultLength = sizeof(ULONG);
         }
