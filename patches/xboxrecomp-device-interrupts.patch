+static void kernel_start_dispatcher(void) {
+    static volatile LONG state;
+    if(InterlockedCompareExchange(&state,1,0)==0) {
+        InitializeCriticalSection(&g_timer_lock);
+        g_timer_started=1;
+        HANDLE thread=CreateThread(NULL,0,kernel_timer_thread,NULL,0,NULL);
+        if(!thread) { fprintf(stderr,"[FATAL IRQ] dispatcher creation failed\n"); abort(); }
+        CloseHandle(thread);
+        InterlockedExchange(&state,2);
+    } else while(InterlockedCompareExchange(&state,0,0)!=2) Sleep(0);
+}
